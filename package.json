{
  "name": "soltonigiri-profile-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "check:html": "html-validate public/index.html public/en/index.html public/404.html",
    "check:js": "node --check public/script.js",
    "check:links": "linkinator public/index.html --recurse --check-fragments --check-css --skip soltonigiri.pages.dev --skip github.com --skip x.com --skip sizu.me",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "check": "npm run check:html && npm run check:js && npm run check:links"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "chrome-launcher": "1.2.1",
    "html-validate": "11.6.2",
    "lighthouse": "13.4.1",
    "linkinator": "8.0.3",
    "wrangler": "4.120.0"
  }
}
